{
  "name": "docchisel",
  "version": "0.1.0",
  "private": true,
  "description": "100% local, offline, all-in-one PDF and Image toolkit",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop:dev": "npm run --workspace=@docchisel/desktop tauri:dev",
    "desktop:dev:web": "npm run --workspace=@docchisel/desktop dev",
    "desktop:build": "npm run --workspace=@docchisel/desktop build",
    "desktop:package:mac": "node scripts/build-desktop.mjs --mac",
    "desktop:package:mac:debug": "node scripts/build-desktop.mjs --mac --debug",
    "desktop:package:mac-universal": "node scripts/build-desktop.mjs --mac-universal",
    "desktop:package:windows": "node scripts/build-desktop.mjs --windows",
    "desktop:package:windows:debug": "node scripts/build-desktop.mjs --windows --debug",
    "desktop:package:linux": "node scripts/build-desktop.mjs --linux",
    "desktop:package:linux:debug": "node scripts/build-desktop.mjs --linux --debug",
    "desktop:package:all": "node scripts/build-desktop.mjs --all",
    "desktop:test": "cargo test --package DocChisel",
    "desktop:clean": "node scripts/clean.mjs --desktop",
    "mobile:start": "npm --workspace=@docchisel/mobile run start --",
    "mobile:android": "npm --workspace=@docchisel/mobile run android --",
    "mobile:android:release": "npm --workspace=@docchisel/mobile run android:release --",
    "mobile:ios": "npm --workspace=@docchisel/mobile run ios --",
    "mobile:ios:release": "npm --workspace=@docchisel/mobile run ios:release --",
    "mobile:build:apk-debug": "node scripts/build-mobile.mjs --apk-debug",
    "mobile:build:apk-release": "node scripts/build-mobile.mjs --apk-release",
    "mobile:build:bundle": "node scripts/build-mobile.mjs --bundle",
    "mobile:build-engine:android": "node scripts/build-mobile-engine.mjs --android",
    "mobile:build-engine:android:release": "node scripts/build-mobile-engine.mjs --release --android",
    "mobile:build-engine:ios": "node scripts/build-mobile-engine.mjs --ios",
    "mobile:build-engine:ios:release": "node scripts/build-mobile-engine.mjs --release --ios",
    "mobile:build-engine:all": "node scripts/build-mobile-engine.mjs --all",
    "mobile:build-engine:all:release": "node scripts/build-mobile-engine.mjs --release --all",
    "mobile:clean:android": "node scripts/clean.mjs --mobile-android",
    "mobile:clean:ios": "node scripts/clean.mjs --mobile-ios",
    "mobile:clean:all": "node scripts/clean.mjs --mobile",
    "package:artifacts": "node scripts/collect-artifacts.mjs",
    "engine:build": "cargo build --package core_engine",
    "engine:test": "cargo test --package core_engine",
    "clean": "node scripts/clean.mjs",
    "clean:intermediates": "node scripts/clean.mjs --intermediates",
    "clean:deep": "node scripts/clean.mjs --deep",
    "prune": "node scripts/prune-intermediates.mjs",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "cargo test --workspace",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:all": "npm run typecheck && cargo test --workspace"
  },
  "keywords": [
    "pdf",
    "image",
    "offline",
    "local-first",
    "privacy"
  ],
  "author": "Ankush Sarkar",
  "license": "Apache-2.0"
}
