{
  "name": "docchisel",
  "version": "0.1.0",
  "private": true,
  "description": "100% local, offline, all-in-one PDF and Image toolkit",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop:dev": "npm run --workspace=@docchisel/desktop tauri:dev",
    "desktop:tauri": "npm run --workspace=@docchisel/desktop tauri --",
    "desktop:build": "npm run --workspace=@docchisel/desktop build",
    "desktop:package:mac": "npm run --workspace=@docchisel/desktop build:mac",
    "desktop:package:mac-universal": "npm run --workspace=@docchisel/desktop build:mac-universal",
    "desktop:package:windows": "npm run --workspace=@docchisel/desktop build:windows",
    "desktop:package:no-bundle": "npm run --workspace=@docchisel/desktop tauri:build:no-bundle",
    "mobile:start": "npm --workspace=@docchisel/mobile run start --",
    "mobile:android": "npm --workspace=@docchisel/mobile run android --",
    "mobile:android:release": "npm --workspace=@docchisel/mobile run android:release --",
    "mobile:ios": "npm --workspace=@docchisel/mobile run ios --",
    "mobile:ios:release": "npm --workspace=@docchisel/mobile run ios:release --",
    "mobile:build:apk-debug": "npm run --workspace=@docchisel/mobile build:apk-debug",
    "mobile:build:apk-release": "npm run --workspace=@docchisel/mobile build:apk-release",
    "mobile:build:bundle": "npm run --workspace=@docchisel/mobile build:bundle",
    "mobile:clean": "npm run --workspace=@docchisel/mobile clean:android",
    "mobile:build-engine": "node scripts/build-mobile-engine.mjs",
    "mobile:build-engine:release": "node scripts/build-mobile-engine.mjs --release",
    "mobile:build-engine:android": "node scripts/build-mobile-engine.mjs --android",
    "mobile:build-engine:android:release": "node scripts/build-mobile-engine.mjs --release --android",
    "mobile:build-engine:ios": "node scripts/build-mobile-engine.mjs --ios",
    "mobile:build-engine:ios:release": "node scripts/build-mobile-engine.mjs --release --ios",
    "package:artifacts": "node scripts/collect-artifacts.mjs",
    "package:android:apk": "npm run mobile:build-engine:android:release && npm run mobile:build:apk-release && npm run package:artifacts",
    "package:android:aab": "npm run mobile:build-engine:android:release && npm run mobile:build:bundle && npm run package:artifacts",
    "package:android": "npm run mobile:build-engine:android:release && npm run mobile:build:apk-release && npm run mobile:build:bundle && npm run package:artifacts",
    "package:mac": "npm run desktop:package:mac && npm run package:artifacts",
    "package:mac-universal": "npm run desktop:package:mac-universal && npm run package:artifacts",
    "package:windows": "npm run desktop:package:windows && npm run package:artifacts",
    "package:ios": "npm run mobile:build-engine:ios:release && npm run mobile:ios:release && npm run package:artifacts",
    "engine:build": "cargo build --package core_engine",
    "engine:test": "cargo test --package core_engine",
    "clean": "node scripts/clean.mjs",
    "clean:intermediates": "node scripts/clean.mjs --intermediates",
    "clean:deep": "node scripts/clean.mjs --deep",
    "prune": "node scripts/prune-intermediates.mjs",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run engine:test",
    "generate:icons": "python3 scripts/generate-brand-assets.py",
    "check:all": "npm run typecheck && npm run engine:test"
  },
  "keywords": [
    "pdf",
    "image",
    "offline",
    "local-first",
    "privacy"
  ],
  "author": "Ankush Sarkar",
  "license": "Apache-2.0"
}
