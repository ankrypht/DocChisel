{
  "name": "docchisel",
  "version": "0.1.0",
  "private": true,
  "description": "100% local, offline, all-in-one PDF and Image toolkit",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "desktop:dev": "npm run --workspace=@docchisel/desktop tauri dev",
    "desktop:package": "node scripts/build-desktop.mjs",
    "linux:download": "node scripts/download-linux-artifacts.mjs",
    "mobile:start": "npm run --workspace=@docchisel/mobile start",
    "mobile:android": "npm run --workspace=@docchisel/mobile android",
    "mobile:ios": "npm run --workspace=@docchisel/mobile ios",
    "mobile:package": "node scripts/build-mobile.mjs",
    "mobile:engine": "node scripts/build-mobile-engine.mjs",
    "package:artifacts": "node scripts/collect-artifacts.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prune": "node scripts/prune-intermediates.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "cargo test --workspace",
    "check:all": "npm run typecheck && cargo test --workspace"
  },
  "keywords": [
    "pdf",
    "image",
    "offline",
    "local-first",
    "privacy"
  ],
  "author": "Ankush Sarkar",
  "license": "Apache-2.0"
}
