{
  "expo": {
    "name": "DocChisel",
    "slug": "docchisel",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "docchisel",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ankushsarkar.docchisel",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DocChisel needs access to your photo library to import images for conversion and editing.",
        "NSPhotoLibraryAddUsageDescription": "DocChisel needs permission to save processed images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B84FE",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "package": "com.ankushsarkar.docchisel"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B84FE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
