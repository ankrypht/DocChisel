{
  "name": "@docchisel/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "build:apk-debug": "node ../../scripts/build-mobile.mjs --apk-debug",
    "build:apk-release": "node ../../scripts/build-mobile.mjs --apk-release",
    "build:bundle": "node ../../scripts/build-mobile.mjs --bundle",
    "clean:android": "node ../../scripts/clean.mjs --mobile-android",
    "clean:ios": "node ../../scripts/clean.mjs --mobile-ios",
    "clean:all": "node ../../scripts/clean.mjs --mobile",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docchisel/shared": "*",
    "clsx": "^2.1.1",
    "docchisel-bridge": "./modules/docchisel-bridge",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-modules-core": "~58.0.23",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
