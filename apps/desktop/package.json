{
  "name": "@docchisel/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:no-bundle": "tauri build --no-bundle",
    "build:mac": "tauri build",
    "build:mac-universal": "tauri build --target universal-apple-darwin",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build",
    "build:all": "npm run build:mac && npm run build:windows",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'node_modules/.vite', 'node_modules/.vite-temp'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\""
  },
  "dependencies": {
    "@docchisel/shared": "*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/darwin-x64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@esbuild/win32-x64": "^0.28.2",
    "@napi-rs/canvas-darwin-arm64": "^1.0.11",
    "@napi-rs/canvas-darwin-x64": "^1.0.11",
    "@napi-rs/canvas-linux-x64-gnu": "^1.0.11",
    "@napi-rs/canvas-win32-x64-msvc": "^1.0.11",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@tailwindcss/oxide-darwin-x64": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@tauri-apps/cli-darwin-arm64": "^2.12.3",
    "@tauri-apps/cli-darwin-x64": "^2.12.3",
    "@tauri-apps/cli-linux-x64-gnu": "^2.12.3",
    "@tauri-apps/cli-win32-x64-msvc": "^2.12.3"
  }
}
