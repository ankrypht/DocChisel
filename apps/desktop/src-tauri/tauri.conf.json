{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocChisel",
  "version": "0.1.0",
  "identifier": "com.ankushsarkar.docchisel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocChisel - 100% Offline PDF & Image Toolkit",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
